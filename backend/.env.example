# Environment variables for IT Support Systems Backend
# Copy this file to .env and fill in your values

# ===== LLM PROVIDER CONFIGURATION =====
# Choose your LLM provider: "openai" or "gemini"
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
CONVERSATION_LLM_FIRST=true

# ===== GOOGLE GEMINI (RECOMMENDED - FREE TIER AVAILABLE) =====
# Get your free API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=models/gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.9
EMBEDDING_MODEL=models/gemini-embedding-001

# ===== OPENAI (OPTIONAL) =====
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# ===== DATABASE =====
DATABASE_URL=sqlite:///./data/processed/it_support_systems.db
CHROMA_PERSIST_DIRECTORY=./data/processed/chroma_db

# ===== REMEDIATION EXECUTION =====
# hybrid    = REAL read-only diagnostics + simulated changes (recommended on macOS)
# simulated = fully simulated machine (use for evaluation and fault injection)
# posix     = real read-only diagnostics only, macOS/Linux
# powershell= real execution, Windows only
# auto      = powershell on Windows, simulated elsewhere
EXECUTION_DRIVER=hybrid

# ===== SECURITY =====
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== API CONFIGURATION =====
DEBUG=True
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:5173